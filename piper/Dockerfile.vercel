FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIPER_MODEL_DIR=/models

WORKDIR /app

RUN python -m pip install --no-cache-dir 'piper-tts[http]==1.8.0' 'gunicorn==23.0.0' \
    && mkdir -p /models \
    && python -m piper.download_voices --download-dir /models en_GB-alba-medium es_AR-daniela-high

COPY server.py /app/server.py

EXPOSE 80

CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT:-80} --workers 1 --threads 1 --timeout 300 server:app"]
